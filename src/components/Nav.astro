---
import Logo from './Logo.astro';

/**
 * Floating navigation.
 * Three-column pill that condenses on scroll, with a Programs mega menu
 * and a full-height sheet on mobile.
 */
const { current = '' } = Astro.props as { current?: string };

const categories = [
  { num: '01', label: 'Commerce', href: '/programs/commerce' },
  { num: '02', label: 'Management', href: '/programs/management' },
  { num: '03', label: 'Computing', href: '/programs/computing' },
  { num: '04', label: 'Arts & Humanities', href: '/programs/arts' },
  { num: '05', label: 'Career counselling', href: '/counselling' },
];

const links = [
  { label: 'Counselling', href: '/counselling', key: 'counselling' },
  { label: 'Sessions', href: '/#sessions', key: 'sessions' },
  { label: 'Contact', href: '/#inquire', key: 'contact' },
];

const arrow = `<svg width="12" height="12" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>`;
---

<div class="nav-wrap">
  <nav class="nav" id="site-nav" aria-label="Primary">
    <a class="brand-link" href="/" aria-label="BookMyDegree — home">
      <Logo />
    </a>

    <ul class="nav-links" role="list">
      <li class="nav-item" data-mega-item>
        <button
          class="nav-link"
          type="button"
          aria-expanded="false"
          aria-controls="mega-programs"
          data-mega-trigger
        >
          Programs
          <svg width="9" height="9" viewBox="0 0 10 10" fill="none" aria-hidden="true">
            <path d="M2 4l3 3 3-3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </button>

        <div class="mega" id="mega-programs" data-mega>
          <ul class="mega-list" role="list">
            {categories.map((c) => (
              <li>
                <a class="mega-row" href={c.href}>
                  <span class="mega-num">{c.num}</span>
                  <span class="mega-label">
                    <span class="sans">{c.label}</span>
                    <span class="serif" aria-hidden="true">{c.label}</span>
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </li>

      {links.map((l) => (
        <li class="nav-item">
          <a
            class:list={['nav-link', { 'nav-link--current': current === l.key }]}
            href={l.href}
          >
            {l.label}
          </a>
        </li>
      ))}
    </ul>

    <div class="nav-actions">
      <a class="pill pill--gold" href="/#inquire">
        Book free counselling
        <span class="pill-arrow">
          <Fragment set:html={arrow} />
          <Fragment set:html={arrow} />
        </span>
      </a>
    </div>

    <button
      class="nav-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="nav-sheet"
      aria-label="Open menu"
      data-sheet-open
    >
      <svg width="18" height="18" viewBox="0 0 20 20" fill="none" aria-hidden="true">
        <path d="M3 6h14M3 13h14" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" />
      </svg>
    </button>
  </nav>
</div>

<!-- Mobile sheet -->
<div class="sheet" id="nav-sheet" aria-label="Menu" data-sheet>
  <div class="sheet-head">
    <a class="brand-link" href="/" aria-label="BookMyDegree — home">
      <Logo />
    </a>
    <button class="sheet-close" type="button" aria-label="Close menu" data-sheet-close>
      <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
        <path d="M3 3l10 10M13 3L3 13" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" />
      </svg>
    </button>
  </div>

  <div>
    <ul class="sheet-list" role="list">
      <li><a href="/#programs"><span>01</span> Programs</a></li>
      {categories.slice(0, 4).map((c, i) => (
        <li><a href={c.href}><span>0{i + 2}</span> <Fragment set:html={c.label} /></a></li>
      ))}
      <li><a href="/counselling"><span>06</span> Counselling</a></li>
      <li><a href="/#sessions"><span>07</span> Sessions</a></li>
      <li><a href="/#inquire"><span>08</span> Contact</a></li>
    </ul>

    <a class="pill pill--gold sheet-cta" href="/#inquire">
      Book free counselling
      <span class="pill-arrow">
        <Fragment set:html={arrow} />
        <Fragment set:html={arrow} />
      </span>
    </a>
  </div>
</div>

<script>
  (function () {
    /* ---------------- Mega menu ---------------- */
    const item = document.querySelector('[data-mega-item]');
    const trigger = document.querySelector('[data-mega-trigger]');
    const mega = document.querySelector('[data-mega]');

    if (item && trigger && mega) {
      let closeTimer = 0;

      const open = () => {
        window.clearTimeout(closeTimer);
        mega.classList.add('is-open');
        trigger.setAttribute('aria-expanded', 'true');
      };

      // 120ms intent delay stops the menu flickering shut on the way down.
      const close = (delay = 120) => {
        window.clearTimeout(closeTimer);
        closeTimer = window.setTimeout(() => {
          mega.classList.remove('is-open');
          trigger.setAttribute('aria-expanded', 'false');
        }, delay);
      };

      item.addEventListener('pointerenter', open);
      item.addEventListener('pointerleave', () => close());
      trigger.addEventListener('click', () => {
        if (mega.classList.contains('is-open')) close(0);
        else open();
      });
      trigger.addEventListener('focus', open);
      item.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') {
          close(0);
          trigger.focus();
        }
      });
      document.addEventListener('click', (e) => {
        if (!item.contains(e.target as Node)) close(0);
      });
      mega.addEventListener('focusout', (e) => {
        if (!item.contains(e.relatedTarget as Node)) close(0);
      });
    }

    /* ---------------- Mobile sheet ---------------- */
    const sheet = document.querySelector('[data-sheet]');
    const openBtn = document.querySelector('[data-sheet-open]');
    const closeBtn = document.querySelector('[data-sheet-close]');

    if (sheet && openBtn && closeBtn) {
      const setOpen = (isOpen: boolean) => {
        sheet.classList.toggle('is-open', isOpen);
        openBtn.setAttribute('aria-expanded', String(isOpen));
        document.body.style.overflow = isOpen ? 'hidden' : '';
        (isOpen ? closeBtn : openBtn).focus();
      };

      openBtn.addEventListener('click', () => setOpen(true));
      closeBtn.addEventListener('click', () => setOpen(false));
      sheet.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && sheet.classList.contains('is-open')) setOpen(false);
      });
    }
  })();
</script>

<style>
  /* Below the desktop breakpoint the pill is logo + one button only. */
  @media (max-width: 899px) {
    .nav {
      grid-template-columns: 1fr auto;
    }
  }

  .nav-item {
    position: relative;
  }

  .brand-link {
    display: inline-flex;
    align-items: center;
    justify-self: start;
    min-width: 0;
  }

  .mega {
    inset-inline-start: 50%;
    inset-block-start: calc(100% + 14px);
    transform: translateX(-50%);
  }
</style>
